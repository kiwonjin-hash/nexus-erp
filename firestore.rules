rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 2026-08-18: Firebase Auth 도입 완료 — 로그인한 사용자면 전체 접근 허용
    // (역할 구분 없음, 소규모 팀 규모에 맞춰 단순화. 계정은 Firebase 콘솔에서 수동 발급)
    // 웹훅 서버(재고관리 웹훅/)는 Firebase Admin SDK로 붙기 때문에 이 rules 자체를
    // 우회한다 — 여기서 auth를 요구해도 웹훅 동기화는 끊기지 않는다.

    match /inventory/{sku} {
      allow read, write: if request.auth != null;
    }

    match /orders/{orderId} {
      allow read, write: if request.auth != null;

      match /shipments/{shipmentId} {
        allow read, write: if request.auth != null;
      }
    }

    // collectionGroup 쿼리 허용 (발렉스/방문수령/우체국 목록 조회)
    match /{path=**}/shipments/{shipmentId} {
      allow read, write: if request.auth != null;
    }

    match /logs/{logId} {
      allow read, write: if request.auth != null;
    }

    match /products/{prodNo} {
      allow read, write: if request.auth != null;
    }

    // 재고 변동 원장 (감사 추적용 — 로그인한 사용자만 생성 가능, 수정/삭제는 항상 불가)
    match /stock_logs/{logId} {
      allow read, create: if request.auth != null;
      allow update, delete: if false;
    }
  }
}
