rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 현재: 인증 미구현으로 임시 허용 상태
    // TODO: Firebase Auth 로그인 구현 후 아래 주석 해제
    // match /{document=**} {
    //   allow read, write: if request.auth != null && request.auth.token.admin == true;
    // }

    // 임시 규칙 — 프론트엔드 Auth 구현 전까지 유지
    // ⚠️ 반드시 Auth 구현 후 위 규칙으로 교체할 것
    match /inventory/{sku} {
      allow read, write: if true;
    }

    match /orders/{orderId} {
      allow read, write: if true;

      match /shipments/{shipmentId} {
        allow read, write: if true;
      }
    }

    // collectionGroup 쿼리 허용 (발렉스/방문수령/우체국 목록 조회)
    match /{path=**}/shipments/{shipmentId} {
      allow read, write: if true;
    }

    match /logs/{logId} {
      allow read, write: if true;
    }

    match /products/{prodNo} {
      allow read, write: if true;
    }

    // 재고 변동 원장 (감사 추적용 — 생성만 허용, 수정/삭제 불가)
    match /stock_logs/{logId} {
      allow read, create: if true;
      allow update, delete: if false;
    }
  }
}
